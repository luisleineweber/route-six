{
  "name": "pokemon-playthrough-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validators:compile": "tsx scripts/compile-validators.ts",
    "predev": "npm run validators:compile",
    "pretest": "npm run validators:compile",
    "prebuild": "npm run validators:compile",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run data:check && tsc -b && vite build && tsx scripts/copy-docs.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "data:check": "tsx scripts/check-data.ts"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.8",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
