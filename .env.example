# Public site URL for the footer link and PNG credit. Set this when published.
VITE_SITE_URL=

# Public HTTPS site URL for canonical URL, structured data, and sitemap.
# A path must end with "/" and becomes the Vite base. Leave blank locally.
# GitHub Pages: https://luisleineweber.github.io/route-six/
SITE_URL=

# Optional Search Console HTML tag content value. Set it only for the release build.
GOOGLE_SITE_VERIFICATION=
