{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokemon-playthrough-planner.local/schema/acquisition.schema.json",
  "title": "Pokémon sources and evolution definitions",
  "$defs": {
    "sourceLevel": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "value"],
          "properties": { "kind": { "const": "fixed" }, "value": { "$ref": "common.schema.json#/$defs/level" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "minimum", "maximum"],
          "properties": {
            "kind": { "const": "range" },
            "minimum": { "$ref": "common.schema.json#/$defs/level" },
            "maximum": { "$ref": "common.schema.json#/$defs/level" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "pokemonId"],
          "properties": {
            "kind": { "const": "match-traded-pokemon" },
            "pokemonId": { "$ref": "common.schema.json#/$defs/id" }
          }
        }
      ]
    },
    "sourceDetails": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "method", "ratePercent"],
          "properties": {
            "kind": { "const": "wild" },
            "method": { "enum": ["grass", "surf", "old-rod", "good-rod", "super-rod", "rock-smash", "headbutt", "bug-contest", "poke-radar", "dark-grass", "grass-spots", "cave-spots", "bridge-spots", "surf-spots", "super-rod-spots", "horde", "rough-terrain", "yellow-flowers", "red-flowers", "purple-flowers", "ceiling-ambush", "ground-ambush", "rustling-bush-ambush", "sky-ambush", "trash-can-ambush"] },
            "ratePercent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "rareTreeOnly"],
          "properties": { "kind": { "const": "honey-tree" }, "rareTreeOnly": { "type": "boolean" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "color"],
          "properties": {
            "kind": { "const": "berry-tree" },
            "color": { "enum": ["red", "blue", "purple", "green", "yellow", "pink"] }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": { "kind": { "enum": ["starter", "gift", "static", "roaming", "egg"] } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "itemId"],
          "properties": {
            "kind": { "const": "fossil" }, "itemId": { "$ref": "common.schema.json#/$defs/id" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "offeredPokemonId"],
          "properties": {
            "kind": { "const": "game-trade" },
            "offeredPokemonId": { "$ref": "common.schema.json#/$defs/id" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "ruleId", "capabilityId"],
          "properties": {
            "kind": { "const": "breeding" },
            "ruleId": { "$ref": "common.schema.json#/$defs/id" },
            "capabilityId": { "$ref": "common.schema.json#/$defs/id" }
          }
        }
      ]
    },
    "encounterCondition": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "seasons"],
          "properties": {
            "kind": { "const": "season" },
            "seasons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["spring", "summer", "autumn", "winter"] } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "periods"],
          "properties": {
            "kind": { "const": "time" },
            "periods": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["morning", "day", "night"] } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "day"],
          "properties": { "kind": { "const": "weekday" }, "day": { "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": { "kind": { "const": "swarm" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "system"],
          "properties": { "kind": { "const": "daily" }, "system": { "enum": ["great-marsh", "trophy-garden"] } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "sound"],
          "properties": { "kind": { "const": "radio" }, "sound": { "enum": ["hoenn", "sinnoh"] } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "category"],
          "properties": { "kind": { "const": "headbutt-tree" }, "category": { "enum": ["common", "rare", "secret"] } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "blocks"],
          "properties": {
            "kind": { "const": "safari-blocks" },
            "blocks": {
              "type": "array", "minItems": 1, "maxItems": 4,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["type", "points"],
                "properties": {
                  "type": { "enum": ["plains", "forest", "peak", "water"] },
                  "points": { "type": "integer", "minimum": 1, "maximum": 210 }
                }
              }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "tileCount", "replacementPercent"],
          "properties": {
            "kind": { "const": "feebas-tiles" }, "tileCount": { "type": "integer", "minimum": 1 },
            "replacementPercent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
          }
        }
      ]
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pokemonId", "locationId", "requirements", "level", "genders", "maxUses", "choice", "details", "review"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "pokemonId": { "$ref": "common.schema.json#/$defs/id" },
        "formId": { "$ref": "common.schema.json#/$defs/optionalId" },
        "locationId": { "$ref": "common.schema.json#/$defs/id" },
        "requirements": { "$ref": "common.schema.json#/$defs/requirement" },
        "level": { "$ref": "#/$defs/sourceLevel" },
        "genders": { "$ref": "common.schema.json#/$defs/genders" },
        "knownMoveIds": { "$ref": "common.schema.json#/$defs/ids" },
        "maxUses": { "$ref": "common.schema.json#/$defs/maxUses" },
        "choice": { "$ref": "common.schema.json#/$defs/optionalChoice" },
        "details": { "$ref": "#/$defs/sourceDetails" },
        "encounterConditions": { "type": "array", "items": { "$ref": "#/$defs/encounterCondition" } },
        "review": { "$ref": "common.schema.json#/$defs/review" }
      },
      "allOf": [
        {
          "if": { "properties": { "details": { "properties": { "kind": { "const": "roaming" } } } } },
          "then": {
            "properties": {
              "maxUses": { "const": 1 },
              "level": { "properties": { "kind": { "const": "fixed" } } }
            }
          }
        },
        {
          "if": { "properties": { "level": { "properties": { "kind": { "const": "match-traded-pokemon" } } } } },
          "then": { "properties": { "details": { "properties": { "kind": { "const": "game-trade" } } } } }
        },
        {
          "if": { "properties": { "details": { "properties": { "kind": { "const": "breeding" } } } } },
          "then": {
            "properties": {
              "maxUses": { "type": "null" },
              "level": { "properties": { "kind": { "const": "fixed" } } }
            }
          }
        }
      ]
    },
    "moveLearning": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "level"],
          "properties": {
            "kind": { "const": "level-up" }, "level": { "$ref": "common.schema.json#/$defs/level" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "minimumLevel", "requirements"],
          "properties": {
            "kind": { "const": "teach" }, "minimumLevel": { "$ref": "common.schema.json#/$defs/level" },
            "requirements": { "$ref": "common.schema.json#/$defs/requirement" }
          }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "minimum"],
          "properties": {
            "kind": { "enum": ["friendship", "beauty"] },
            "minimum": { "type": "integer", "minimum": 1, "maximum": 255 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "period"],
          "properties": { "kind": { "const": "time" }, "period": { "enum": ["day", "night"] } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "relation"],
          "properties": {
            "kind": { "const": "stats" },
            "relation": { "enum": ["attack-lt-defense", "attack-eq-defense", "attack-gt-defense"] }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "modulus", "minimum", "maximum"],
          "properties": {
            "kind": { "const": "personality" },
            "modulus": { "type": "integer", "minimum": 2 },
            "minimum": { "type": "integer", "minimum": 0 },
            "maximum": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "freeSlots"],
          "properties": {
            "kind": { "const": "party-space" }, "freeSlots": { "type": "integer", "minimum": 1, "maximum": 5 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "locationId"],
          "properties": {
            "kind": { "const": "location" }, "locationId": { "$ref": "common.schema.json#/$defs/id" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "itemId"],
          "properties": {
            "kind": { "const": "held-item" }, "itemId": { "$ref": "common.schema.json#/$defs/id" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "pokemonId"],
          "properties": {
            "kind": { "const": "party-pokemon" }, "pokemonId": { "$ref": "common.schema.json#/$defs/id" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "moveId", "moveName", "learning"],
          "properties": {
            "kind": { "const": "known-move" },
            "moveId": { "$ref": "common.schema.json#/$defs/id" },
            "moveName": { "$ref": "common.schema.json#/$defs/text" },
            "learning": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/moveLearning" } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "typeId"],
          "properties": {
            "kind": { "const": "party-type" }, "typeId": { "$ref": "common.schema.json#/$defs/id" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "minimum"],
          "properties": { "kind": { "const": "affection" }, "minimum": { "const": 50 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "weather"],
          "properties": { "kind": { "const": "weather" }, "weather": { "const": "rain" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "orientation"],
          "properties": { "kind": { "const": "device-orientation" }, "orientation": { "const": "upside-down" } }
        }
      ]
    },
    "evolution": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "fromPokemonId", "toPokemonId", "trigger", "minimumLevel", "itemId",
        "conditions", "genderTransitions", "requirements", "coProductIds", "review"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "fromPokemonId": { "$ref": "common.schema.json#/$defs/id" },
        "toPokemonId": { "$ref": "common.schema.json#/$defs/id" },
        "fromFormId": { "$ref": "common.schema.json#/$defs/optionalId" },
        "toFormId": { "$ref": "common.schema.json#/$defs/optionalId" },
        "trigger": { "enum": ["level-up", "use-item", "player-trade"] },
        "minimumLevel": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/level" }] },
        "itemId": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/id" }] },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "genderTransitions": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["from", "to"],
                "properties": {
                  "from": { "$ref": "common.schema.json#/$defs/gender" },
                  "to": { "$ref": "common.schema.json#/$defs/gender" }
                }
              }
            }
          ]
        },
        "requirements": { "$ref": "common.schema.json#/$defs/requirement" },
        "coProductIds": { "$ref": "common.schema.json#/$defs/ids" },
        "excludedSourceIds": { "$ref": "common.schema.json#/$defs/ids" },
        "review": { "$ref": "common.schema.json#/$defs/review" }
      },
      "allOf": [
        {
          "if": { "properties": { "trigger": { "const": "use-item" } } },
          "then": {
            "properties": {
              "itemId": { "$ref": "common.schema.json#/$defs/id" }, "minimumLevel": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "trigger": { "const": "level-up" } } },
          "then": { "properties": { "itemId": { "type": "null" } } }
        },
        {
          "if": { "properties": { "trigger": { "const": "player-trade" } } },
          "then": { "properties": { "minimumLevel": { "type": "null" } } }
        }
      ]
    },
    "formChange": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pokemonId", "fromFormId", "toFormId", "heldItemId", "requirements", "review"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "pokemonId": { "$ref": "common.schema.json#/$defs/id" },
        "fromFormId": { "$ref": "common.schema.json#/$defs/optionalId" },
        "toFormId": { "$ref": "common.schema.json#/$defs/optionalId" },
        "heldItemId": { "$ref": "common.schema.json#/$defs/optionalId" },
        "requirements": { "$ref": "common.schema.json#/$defs/requirement" },
        "review": { "$ref": "common.schema.json#/$defs/review" }
      }
    },
    "exclusion": {
      "type": "object", "additionalProperties": false,
      "required": ["pokemonId", "reason", "explanation", "review"],
      "properties": {
        "pokemonId": { "$ref": "common.schema.json#/$defs/id" },
        "reason": { "enum": ["other-version", "external-event", "external-connection"] },
        "explanation": { "$ref": "common.schema.json#/$defs/text" },
        "review": { "$ref": "common.schema.json#/$defs/review" }
      }
    }
  }
}
