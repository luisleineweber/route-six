{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokemon-playthrough-planner.local/schema/common.schema.json",
  "title": "Shared planner data definitions",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1 },
    "optionalId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "level": { "type": "integer", "minimum": 1, "maximum": 100 },
    "gender": { "enum": ["male", "female", "genderless", "not-applicable"] },
    "genders": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/gender" }
    },
    "eggGroupId": {
      "enum": [
        "monster", "water-1", "bug", "flying", "field", "fairy", "grass",
        "human-like", "water-3", "mineral", "amorphous", "water-2", "ditto", "dragon", "undiscovered"
      ]
    },
    "ids": {
      "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["referenceIds", "checkedOn"],
      "properties": {
        "referenceIds": { "$ref": "#/$defs/ids", "minItems": 1 },
        "checkedOn": { "type": "string", "format": "date" }
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "locator"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "locator": { "$ref": "#/$defs/text" },
        "url": { "type": "string", "format": "uri" },
        "revision": { "$ref": "#/$defs/text" }
      }
    },
    "pokemon": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "nationalDex", "name", "introducedGeneration", "review"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nationalDex": { "type": "integer", "minimum": 1 },
        "name": { "$ref": "#/$defs/text" },
        "introducedGeneration": { "type": "integer", "minimum": 1 },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "pokemonForm": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pokemonId", "name", "introducedGeneration", "review"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "pokemonId": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "introducedGeneration": { "type": "integer", "minimum": 1 },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "choiceSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["groupId", "optionId"],
      "properties": {
        "groupId": { "$ref": "#/$defs/id" },
        "optionId": { "$ref": "#/$defs/id" }
      }
    },
    "optionalChoice": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/choiceSelection" }]
    },
    "maxUses": { "type": ["integer", "null"], "minimum": 1 },
    "requirement": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "requirements"],
          "properties": {
            "kind": { "const": "all" },
            "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "requirements"],
          "properties": {
            "kind": { "const": "any" },
            "requirements": {
              "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["milestone", "location", "capability"] },
            "id": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "id", "quantity", "consumed"],
          "properties": {
            "kind": { "enum": ["item", "pokemon"] },
            "id": { "$ref": "#/$defs/id" },
            "quantity": { "type": "integer", "minimum": 1 },
            "consumed": { "type": "boolean" }
          }
        }
      ]
    }
  }
}
